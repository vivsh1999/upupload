{
  "name": "@vivsh1999/upupload",
  "version": "0.0.2",
  "description": "Client-first, multi-stage media uploader/processor with safe fallback-to-original behavior",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivsh1999/upupload.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.mts",
      "import": "./dist/browser/index.mjs",
      "default": "./dist/browser/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs",
      "default": "./dist/core/index.mjs"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs",
      "default": "./dist/server/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/core/index.ts src/browser/index.ts src/react/index.ts src/server/index.ts",
    "dev": "vp pack src/index.ts src/core/index.ts src/browser/index.ts src/react/index.ts src/server/index.ts --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "bench": "vitest bench",
    "dev:tanstack-start": "pnpm --dir examples/tanstack-start dev",
    "build:tanstack-start": "pnpm --dir examples/tanstack-start build",
    "preview:tanstack-start": "pnpm --dir examples/tanstack-start preview",
    "dev:vanilla-html": "pnpm --dir examples/vanilla-html dev",
    "build:vanilla-html": "pnpm --dir examples/vanilla-html build",
    "preview:vanilla-html": "pnpm --dir examples/vanilla-html preview"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "libraw-wasm": "^1.1.2",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "canvas": "^3.1.0",
    "jsdom": "^28.1.0",
    "react": "^19.2.0",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
